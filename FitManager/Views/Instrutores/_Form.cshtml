@model InstrutorFormViewModel
@{
    var edicao = ViewData["Edicao"] is true;
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" maxlength="100" autofocus />
        <span asp-validation-for="Nome"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Cref" class="form-label"></label>
        <input asp-for="Cref" class="form-control" maxlength="20" placeholder="Ex.: 012345-G/PR" />
        <span asp-validation-for="Cref"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" maxlength="20" placeholder="(00) 00000-0000" data-mascara="telefone" inputmode="tel" />
        <span asp-validation-for="Telefone"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" maxlength="100" placeholder="nome@exemplo.com" autocomplete="off" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="col-md-6">
        @if (!edicao)
        {
            <label asp-for="Senha" class="form-label">Senha inicial de acesso</label>
        }
        else if (Model.PossuiAcesso)
        {
            <label asp-for="Senha" class="form-label">Nova senha de acesso (opcional)</label>
        }
        else
        {
            <label asp-for="Senha" class="form-label">Senha de acesso (opcional)</label>
        }
        <input asp-for="Senha" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Senha"></span>
    </div>
    <div class="col-md-6 d-flex align-items-end">
        <div class="form-text">
            @if (!edicao)
            {
                <span>O instrutor entra no sistema com o e-mail acima e esta senha, e pode trocá-la depois em "Minha conta".</span>
            }
            else if (Model.PossuiAcesso)
            {
                <span>Preencha apenas para redefinir a senha do instrutor.</span>
            }
            else
            {
                <span>Este instrutor ainda não tem acesso ao sistema. Informe uma senha para criar o login dele.</span>
            }
            Mínimo de 6 caracteres, com letra maiúscula, minúscula, número e símbolo.
        </div>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label"></label>
            <div class="form-text mt-0">Instrutores inativos não aparecem nas fichas de treino e não conseguem entrar no sistema.</div>
        </div>
    </div>
</div>
