@model Treino
@{
    ViewData["Title"] = Model.Nome;
    var instrutorLogadoId = ViewBag.InstrutorLogadoId as int?;
    var podeAlterar = Model.InstrutorId == instrutorLogadoId;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@Model.Nome</h1>
        @if (Model.Ativo)
        {
            <span class="badge text-bg-success">Ficha ativa</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Ficha inativa</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-2 nao-imprimir">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
        @if (podeAlterar)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Excluir</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0 dl-dados">
            <dt class="col-sm-2">Aluno</dt>
            <dd class="col-sm-4">@Model.Aluno?.Nome</dd>
            <dt class="col-sm-2">Instrutor</dt>
            <dd class="col-sm-4">@Model.Instrutor?.Nome (CREF @Model.Instrutor?.Cref)</dd>
            <dt class="col-sm-2">Objetivo</dt>
            <dd class="col-sm-4 mb-0">@(string.IsNullOrWhiteSpace(Model.Objetivo) ? "—" : Model.Objetivo)</dd>
            <dt class="col-sm-2">Criada em</dt>
            <dd class="col-sm-4 mb-0">@Model.DataCriacao.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Exercícios</div>
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Exercício</th>
                    <th>Grupo muscular</th>
                    <th class="text-center">Séries</th>
                    <th class="text-center">Repetições</th>
                    <th class="text-center">Carga</th>
                    <th class="text-center">Descanso</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Itens.OrderBy(i => i.Ordem))
                {
                    <tr>
                        <td class="text-center">@item.Ordem</td>
                        <td>
                            <div class="fw-semibold">@item.Exercicio?.Nome</div>
                            <div class="small text-muted">@item.Exercicio?.Descricao</div>
                        </td>
                        <td>@item.Exercicio?.GrupoMuscular</td>
                        <td class="text-center">@item.Series</td>
                        <td class="text-center">@item.Repeticoes</td>
                        <td class="text-center">@(item.CargaKg.HasValue ? item.CargaKg.Value.ToString("0.##") + " kg" : "—")</td>
                        <td class="text-center">@item.DescansoSegundos s</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
