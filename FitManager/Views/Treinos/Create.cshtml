@model TreinoFormViewModel
@{
    ViewData["Title"] = "Nova ficha de treino";
    ViewData["Edicao"] = false;
}

<h1 class="h3 mb-3">Nova ficha de treino</h1>

<form asp-action="Create" method="post" id="formTreino">
    <partial name="_Form" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar ficha</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/treino.js" asp-append-version="true"></script>
}
