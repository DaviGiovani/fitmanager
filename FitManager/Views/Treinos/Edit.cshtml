@model TreinoFormViewModel
@{
    ViewData["Title"] = "Editar ficha de treino";
    ViewData["Edicao"] = true;
}

<h1 class="h3 mb-3">Editar ficha de treino</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="formTreino">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Salvar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/treino.js" asp-append-version="true"></script>
}
