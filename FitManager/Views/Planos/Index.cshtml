@model List<Plano>
@{
    ViewData["Title"] = "Planos";
    var matriculasAtivas = (Dictionary<int, int>)ViewBag.MatriculasAtivas;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Planos</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo plano</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Nenhum plano cadastrado. Cadastre o primeiro plano para poder realizar matrículas.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Plano</th>
                            <th class="text-center">Duração</th>
                            <th class="text-end">Valor mensal</th>
                            <th class="text-center">Matrículas ativas</th>
                            <th>Situação</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var plano in Model)
                        {
                            var quantidade = matriculasAtivas.TryGetValue(plano.Id, out var total) ? total : 0;
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @plano.Nome
                                        @if (plano.AceitaGymPass)
                                        {
                                            <span class="badge text-bg-info ms-1">Aceita GymPass</span>
                                        }
                                    </div>
                                    <div class="small text-muted">@plano.Descricao</div>
                                </td>
                                <td class="text-center">@plano.DuracaoMeses @(plano.DuracaoMeses == 1 ? "mês" : "meses")</td>
                                <td class="text-end">@plano.ValorMensal.ToString("C")</td>
                                <td class="text-center">@quantidade</td>
                                <td>
                                    @if (plano.Ativo)
                                    {
                                        <span class="badge text-bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Inativo</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@plano.Id" class="btn btn-sm btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@plano.Id" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
