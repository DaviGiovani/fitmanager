@model Plano

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" maxlength="60" placeholder="Ex.: Mensal, Trimestral, Anual" autofocus />
        <span asp-validation-for="Nome"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DuracaoMeses" class="form-label"></label>
        <input asp-for="DuracaoMeses" class="form-control" type="number" min="1" max="60" step="1" />
        <span asp-validation-for="DuracaoMeses"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ValorMensal" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">R$</span>
            <input asp-for="ValorMensal" class="form-control" type="text" inputmode="decimal" placeholder="Ex.: 89,90" />
        </div>
        <span asp-validation-for="ValorMensal"></span>
    </div>
    <div class="col-12">
        <label asp-for="Descricao" class="form-label"></label>
        <textarea asp-for="Descricao" class="form-control" rows="2" maxlength="255"></textarea>
        <span asp-validation-for="Descricao"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="AceitaGymPass" class="form-check-input" />
            <label asp-for="AceitaGymPass" class="form-check-label"></label>
            <div class="form-text mt-0">Quando marcado, o GymPass aparece como forma de pagamento das matrículas deste plano.</div>
        </div>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label">Plano ativo (disponível para novas matrículas)</label>
        </div>
    </div>
</div>
