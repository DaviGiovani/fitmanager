@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var navInicio = controllerAtual == "Home" ? "active" : "";
    var navAlunos = controllerAtual == "Alunos" ? "active" : "";
    var navPlanos = controllerAtual == "Planos" ? "active" : "";
    var navMatriculas = controllerAtual == "Matriculas" ? "active" : "";
    var navPagamentos = controllerAtual == "Pagamentos" ? "active" : "";
    var navTreinos = controllerAtual == "Treinos" ? "active" : "";
    var navInstrutores = controllerAtual == "Instrutores" ? "active" : "";
    var perfil = User.IsInRole(Perfis.Administrador) ? Perfis.Administrador
        : User.IsInRole(Perfis.Instrutor) ? Perfis.Instrutor : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – FitManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-fm">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-activity"></i> FitManager
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @navInicio" asp-controller="Home" asp-action="Index">Início</a>
                    </li>
                    @if (User.IsInRole(Perfis.Administrador))
                    {
                        <li class="nav-item">
                            <a class="nav-link @navAlunos" asp-controller="Alunos" asp-action="Index">Alunos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navPlanos" asp-controller="Planos" asp-action="Index">Planos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navMatriculas" asp-controller="Matriculas" asp-action="Index">Matrículas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navPagamentos" asp-controller="Pagamentos" asp-action="Index">Pagamentos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @navInstrutores" asp-controller="Instrutores" asp-action="Index">Instrutores</a>
                        </li>
                    }
                    @if (User.IsInRole(Perfis.Instrutor))
                    {
                        <li class="nav-item">
                            <a class="nav-link @navTreinos" asp-controller="Treinos" asp-action="Index">Fichas de treino</a>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="navbar-text small">
                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                        @if (perfil != "")
                        {
                            <span class="badge text-bg-secondary ms-1">@perfil</span>
                        }
                    </span>
                    <a asp-controller="Account" asp-action="MinhaConta" class="btn btn-sm btn-outline-light" title="Editar e-mail e senha de acesso">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-box-arrow-right"></i> Sair
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <partial name="_Alertas" />
        @RenderBody()
    </main>

    <footer class="border-top bg-white py-3 mt-4">
        <div class="container small text-muted">
            © FitManager – Sistema de gestão de academia · Todos os direitos reservados
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
