@model List<Matricula>
@{
    ViewData["Title"] = "Registrar pagamento";
    var hoje = DateTime.Today;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Registrar pagamento</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>

<div class="card">
    <div class="card-header bg-white fw-semibold">Selecione a matrícula do aluno</div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">Não há matrículas ativas no momento.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Plano</th>
                        <th>Período</th>
                        <th class="text-end">Valor mensal</th>
                        <th class="text-center">Em aberto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var matricula in Model)
                    {
                        var emAberto = matricula.MesesEmAberto(hoje).Count();
                        var pendentes = matricula.MesesPendentes().Count();
                        <tr>
                            <td>@matricula.Aluno?.Nome</td>
                            <td>@matricula.Plano?.Nome</td>
                            <td>@matricula.DataInicio.ToString("dd/MM/yyyy") a @matricula.DataFim.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">@matricula.ValorMensal.ToString("C")</td>
                            <td class="text-center">
                                @if (emAberto > 0)
                                {
                                    <span class="badge text-bg-danger">@emAberto</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (pendentes > 0)
                                {
                                    <a asp-action="Create" asp-route-matriculaId="@matricula.Id" class="btn btn-sm btn-primary">Selecionar</a>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Quitada</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
