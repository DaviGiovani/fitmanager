@model PaginatedList<Pagamento>
@{
    ViewData["Title"] = "Pagamentos";
    var busca = ViewData["Busca"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Pagamentos</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-cash-coin"></i> Registrar pagamento</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 mb-3">
            <div class="col-sm-8 col-md-6">
                <input type="search" name="busca" value="@busca" class="form-control" placeholder="Pesquisar por nome do aluno" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Pesquisar</button>
                @if (!string.IsNullOrWhiteSpace(busca))
                {
                    <a asp-action="Index" class="btn btn-link">Limpar</a>
                }
            </div>
        </form>

        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Nenhum pagamento encontrado.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Aluno</th>
                            <th>Plano</th>
                            <th>Mês de referência</th>
                            <th>Forma</th>
                            <th class="text-end">Valor</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pagamento in Model)
                        {
                            <tr>
                                <td>@pagamento.DataPagamento.ToString("dd/MM/yyyy")</td>
                                <td>@pagamento.Matricula?.Aluno?.Nome</td>
                                <td>@pagamento.Matricula?.Plano?.Nome</td>
                                <td>@pagamento.MesReferencia.ToString("MM/yyyy")</td>
                                <td>@pagamento.FormaPagamento.Descricao()</td>
                                <td class="text-end">@pagamento.Valor.ToString("C")</td>
                                <td class="text-end">
                                    <a asp-controller="Matriculas" asp-action="Details" asp-route-id="@pagamento.MatriculaId" class="btn btn-sm btn-outline-secondary">Matrícula</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <span class="small text-muted">@Model.TotalItens pagamento(s) · página @Model.PaginaAtual de @Model.TotalPaginas</span>
                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Paginação">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.TemAnterior ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-busca="@busca" asp-route-pagina="@(Model.PaginaAtual - 1)">Anterior</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaAtual ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-busca="@busca" asp-route-pagina="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.TemProxima ? "" : "disabled")">
                                <a class="page-link" asp-action="Index" asp-route-busca="@busca" asp-route-pagina="@(Model.PaginaAtual + 1)">Próxima</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>
