@model Aluno

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" maxlength="100" autofocus />
        <span asp-validation-for="Nome"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Cpf" class="form-label"></label>
        <input asp-for="Cpf" class="form-control" maxlength="14" placeholder="000.000.000-00" data-mascara="cpf" inputmode="numeric" />
        <span asp-validation-for="Cpf"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DataNascimento" class="form-label"></label>
        <input asp-for="DataNascimento" class="form-control" />
        <span asp-validation-for="DataNascimento"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Telefone" class="form-label"></label>
        <input asp-for="Telefone" class="form-control" maxlength="20" placeholder="(00) 00000-0000" data-mascara="telefone" inputmode="tel" />
        <span asp-validation-for="Telefone"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" maxlength="100" placeholder="nome@exemplo.com" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="Ativo" class="form-check-input" />
            <label asp-for="Ativo" class="form-check-label">Aluno ativo</label>
        </div>
    </div>
</div>
